<service>
  <id>seyyah</id>
  <name>Seyyah</name>
  <description>Seyyah web uygulamasi</description>
  <executable>%JAVA_HOME%\bin\java.exe</executable>
  <arguments>-Xmx320m -Xss512k -XX:+UseSerialGC -XX:MaxMetaspaceSize=96m -XX:+ExitOnOutOfMemoryError -Dspring.profiles.active=prod -jar C:\seyyah\seyyah.jar</arguments>
  <workingdirectory>C:\seyyah</workingdirectory>
  <startmode>Automatic</startmode>
  <logpath>C:\seyyah\log</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>5</keepFiles>
  </log>
  <onfailure action="restart" delay="10 sec" />
  <resetfailure>1 hour</resetfailure>
</service>
